{
  "preprocessing": {
    "sampling_frequency": 12000.0,
    "missing_value_strategy": "interpolate",
    "filter_enabled": true,
    "filter_type": "bandpass",
    "filter_order": 5,
    "lowcut": 10.0,
    "highcut": 5000.0,
    "normalization_method": "standardize"
  },
  "windowing": {
    "window_size": 1024,
    "overlap": 0.5,
    "min_signal_length": 4096,
    "step_size": 512
  },
  "stft": {
    "n_fft": 128,
    "hop_length": 32,
    "win_length": 128,
    "window": "hann"
  },
  "model": {
    "cnn1d_filters": [
      16,
      32
    ],
    "cnn1d_kernel_sizes": [
      7,
      5
    ],
    "cnn2d_filters": [
      16,
      32
    ],
    "cnn2d_kernel_sizes": [
      3,
      3
    ],
    "lstm_units": 16,
    "sequence_length": 1,
    "dense_units": 32,
    "dropout_rate": 0.5,
    "num_classes": 5,
    "batch_size": 32,
    "epochs": 40,
    "learning_rate": 0.0005,
    "early_stopping_patience": 10,
    "lr_reduce_patience": 4,
    "lr_reduce_factor": 0.5,
    "validation_split": 0.15,
    "test_split": 0.15,
    "random_seed": 42
  }
}